# Supabase — copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service-role key: only used server-side (scrapers, admin routes, cron jobs).
# NEVER prefix with NEXT_PUBLIC_ — it must stay server-only.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Gemini API — used server-side for AI features (scraping, summaries, etc.)
# Get your key from: https://aistudio.google.com/app/apikey
# NEVER prefix with NEXT_PUBLIC_ — keep it server-only.
GEMINI_API_KEY=<your-gemini-api-key>
