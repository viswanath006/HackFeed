# =============================================================================
# HackFeed — Environment Configuration
# =============================================================================

# 1. Supabase (Database, Auth, SSR Cookies)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# 2. Application Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Email & Notifications (Resend)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=HackFeed <onboarding@resend.dev>

# 4. Scraper Microservice (Optional Fallbacks)
APIFY_API_TOKEN=apify_api_xxx
SCRAPER_UNSTOP_MODE=direct
SCRAPER_DEVFOLIO_MODE=direct
SCRAPER_HACKEREARTH_MODE=direct
SCRAPER_H2SKILL_MODE=direct
SCRAPE_INTERVAL_HOURS=6
API_PORT=8000
API_HOST=0.0.0.0
