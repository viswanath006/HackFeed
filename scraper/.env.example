# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co

# Service-role key: ONLY used server-side in this trusted scraper service
# NEVER expose this key to browser or public clients
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Apify Fallback Configuration (Optional)
# Required only if any platform is switched to "apify" mode in scrapers/config.py
# Get your token from https://console.apify.com/account#/integrations
APIFY_API_TOKEN=your-apify-api-token-here

# Scraper Settings
REQUEST_TIMEOUT_SECONDS=25
MAX_ITEMS_PER_PLATFORM=50
REQUEST_DELAY_SECONDS=1.5
SCRAPE_INTERVAL_HOURS=6
API_PORT=8000
API_HOST=0.0.0.0
